{
  "name": "meloncpp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prepare:toolchain": "node scripts/prepare-toolchain.mjs",
    "predev": "npm run prepare:toolchain",
    "build": "npm run prepare:toolchain && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "cf:whoami": "node scripts/cloudflare.mjs whoami",
    "cf:check": "node scripts/cloudflare.mjs dry-run",
    "cf:deploy": "npm run build && node scripts/cloudflare.mjs deploy"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@lezer/highlight": "^1.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vite": "8.3.8",
    "wrangler": "4.163.0"
  },
  "engines": {
    "node": "22.x"
  }
}
